#!/bin/sh
# Refuse every update or deletion of main, including mixed-ref pushes.
# This guard does no builds, tests, network calls or credential reads.
# The exact-head make verify gate remains mandatory before a PR on its admitted
# builder; running that heavy gate in a developer's pre-push hook is not admission.
set -eu
while read -r local_ref local_oid remote_ref remote_oid extra; do
    if [ -z "$local_ref" ] || [ -z "$local_oid" ] || [ -z "$remote_ref" ] || [ -z "$remote_oid" ] || [ -n "$extra" ]; then
        echo 'Refusing malformed pre-push ref input.' >&2
        exit 1
    fi
    if [ "$remote_ref" = refs/heads/main ]; then
        echo 'Refusing a push to main. Push a short-lived branch for the reviewed merge route.' >&2
        exit 1
    fi
done
